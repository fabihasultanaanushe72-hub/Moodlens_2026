<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#121827">
<androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="match_parent" android:layout_height="match_parent" app:scaleType="fillCenter"/>
<com.example.moodlens.FaceOverlayView android:id="@+id/overlayView" android:layout_width="match_parent" android:layout_height="match_parent"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_margin="16dp" android:gravity="center_vertical" android:orientation="horizontal">
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:background="@drawable/bg_white_card" android:contentDescription="Back"/>
<TextView android:id="@+id/txtCameraStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/bg_camera_panel" android:padding="12dp" android:gravity="center" android:text="Live Detection" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnSwitch" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_switch" android:background="@drawable/bg_white_card" android:contentDescription="Switch camera"/>
</LinearLayout>
<LinearLayout android:id="@+id/resultPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_margin="16dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_white_card">
<TextView android:id="@+id/txtLiveResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Starting camera…" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Keep one face centered in good light" android:textSize="13sp" android:textColor="@color/text_secondary"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCapture" style="@style/ML.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Capture photo" android:visibility="gone" android:layout_marginTop="12dp"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCameraPermission" style="@style/ML.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enable camera" android:visibility="gone" android:layout_marginTop="12dp"/>
</LinearLayout></FrameLayout>